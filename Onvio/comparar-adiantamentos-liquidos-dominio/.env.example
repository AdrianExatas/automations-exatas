# Token Onvio (UDS Long Token) - obrigatório para listar documentos
ONVIO_UDS_LONG_TOKEN=

# URL da API BD (pastas) - padrão: http://localhost:3001
API_BD_URL=http://localhost:3001

# Base URL Onvio - padrão: https://onvio.com.br
ONVIO_BASE_URL=https://onvio.com.br

# Firm company ID (x-company-id) - opcional; use se a API Onvio exigir
# ONVIO_FIRM_COMPANY_ID=

# Teste: processar apenas uma empresa (onvio_company_id). Ex.: 259 = Litoral Indústria
# FILTER_COMPANY_ID=259

# Teste: usar estes folder_id em vez do BD (ex.: o que funcionou no Postman). Vírgula = vários.
# TEST_FOLDER_IDS=e6b8a93c845c4a4499f21090eb3078ca

# Pasta onde salvar os PDFs baixados pelo script baixar-documentos-adiantamento (default: ./downloads)
# DOWNLOAD_DIR=./downloads
