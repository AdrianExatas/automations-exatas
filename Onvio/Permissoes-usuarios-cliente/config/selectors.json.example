    "cpf": [
      {
        "type": "testid",
        "value": "cpf",
        "description": "data-testid",
        "priority": 1
      },
      {
        "type": "selector",
        "value": "input[formcontrolname*=\"cpf\" i], input[id*=\"cpf\" i]",
