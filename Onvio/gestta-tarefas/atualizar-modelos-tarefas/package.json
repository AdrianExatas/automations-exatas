{
  "name": "atualizar-modelos-tarefas-gestta",
  "version": "1.0.0",
  "private": true,
  "description": "CLI para atualizar modelos de tarefa Gestta (rename, recorrência, active) com dry-run/apply, backup e relatório",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "ts-node src/index.ts",
    "dry-run": "ts-node src/index.ts --dry-run",
    "apply": "ts-node src/index.ts --apply"
  },
  "dependencies": {
    "axios": "^1.6.0",
    "dotenv": "^16.3.0"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.0"
  }
}
