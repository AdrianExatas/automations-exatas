# JWT do Gestta (sem o prefixo "JWT ")
JWT_GESTTA=

# Opcional: caminho da planilha. Padrao: data/PROVISAO DP.xlsx
# PLANILHA_PATH=data/PROVISAO DP.xlsx

# Opcional: caminho explicito do artefato gerado por shared/onvio-auth.
# Se nao informado, a automacao tenta usar shared/onvio-auth/runtime/latest-auth.json.
# ONVIO_AUTH_ARTIFACT_PATH=

# Opcional: base da API local para fallback de employees
# LOCAL_API_URL=http://localhost:3001

# Opcional: timeout HTTP do Gestta em ms
# GESTTA_HTTP_TIMEOUT_MS=60000

# Opcional: retries para leituras GET no Gestta
# GESTTA_READ_RETRIES=3

# Opcional: espera entre retries de leitura em ms
# GESTTA_READ_RETRY_DELAY_MS=1000

# Opcional: concorrencia para consultar /admin/customer/:id/company/task
# GESTTA_CUSTOMER_TASK_CONCURRENCY=5
