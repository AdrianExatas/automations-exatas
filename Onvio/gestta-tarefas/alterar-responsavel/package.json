{
  "name": "alterar-responsavel-gestta",
  "version": "1.0.0",
  "description": "Automação para alterar responsável de tarefas no Gestta a partir da planilha DP RESPONSÁVEL.xlsx",
  "main": "dist/electron/main.js",
  "scripts": {
    "build": "tsc && bun run copy:electron-assets",
    "copy:electron-assets": "node -e \"const fs=require('fs');fs.mkdirSync('dist/electron',{recursive:true});for(const f of ['renderer.html','renderer.css','renderer.js'])fs.copyFileSync('src/electron/'+f,'dist/electron/'+f)\"",
    "build:installer": "bun run build && electron-builder --win nsis --x64",
    "start": "node dist/index.js",
    "start:selecionar": "node dist/index.js --selecionar",
    "start:reprocessar": "node dist/index.js --reprocessar",
    "dev": "ts-node src/index.ts",
    "dev:selecionar": "ts-node src/index.ts --selecionar",
    "electron": "bun run build && electron dist/electron/main.js",
    "relatorio:xlsx": "node dist/scripts/converter-relatorio-xlsx.js",
    "test": "node --test -r ts-node/register test/cnpj.test.ts test/client-auth.test.ts test/runtime-auth.test.ts test/preflight-auth.test.ts test/planilha-padrao.test.ts test/planilha-estrutura.test.ts test/sheet-settings.test.ts test/automation-auth-fatal.test.ts test/automation-args.test.ts test/rollback.test.ts test/reinf.test.ts test/reatribuicao-fiscal.test.ts test/reatribuicao-pessoal.test.ts test/reatribuicao-pessoal-pendentes.test.ts"
  },
  "dependencies": {
    "axios": "^1.6.0",
    "dotenv": "^16.3.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "electron": "^37.2.0",
    "electron-builder": "^26.0.12",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.0"
  },
  "build": {
    "appId": "br.com.exatas.alterar-responsavel-gestta",
    "productName": "Alterar Responsavel Gestta",
    "asar": true,
    "directories": {
      "output": "installer"
    },
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Alterar Responsavel Gestta"
    }
  }
}
