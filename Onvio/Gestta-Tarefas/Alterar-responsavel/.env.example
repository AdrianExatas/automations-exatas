# JWT do Gestta (obtido após login no app; usar no Postman e copiar aqui).
# Suporta JWT_GESTTA ou GESTTA_JWT_TOKEN (compatível com .env do projeto raiz).
JWT_GESTTA=

# Opcional: URL da API local (ex.: http://localhost:3001) para resolver gestta_id por CNPJ
# e validar setores. Se definido, a busca de cliente tenta essa API antes da API Gestta.
# API_3001_URL=

# Opcional: caminho da planilha (padrão: ../data/DP RESPONSÁVEL.xlsx)
# PLANILHA_PATH=../data/DP RESPONSÁVEL.xlsx
