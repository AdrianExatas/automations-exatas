# Unecont
UNECONT_EMAIL=seu_email@exemplo.com
UNECONT_SENHA=sua_senha
EMPRESAS_EXCEL_PATH=assets/templates/empresas-template.xlsx
UNECONT_EMPRESAS_URL=https://app.unecont.com/Contador/Empresas/Default.aspx
UNECONT_EMPRESAS_REPORT_NAME=
BITRIX_COMPETENCIAS_URL=
BITRIX_CONTABIL_URL=
HEADLESS=false
DEFAULT_TIMEOUT=10
SHORT_TIMEOUT=3
LONG_TIMEOUT=20

# Onvio upload
# Pode ficar vazio se ONVIO_AUTO_REFRESH_TOKEN=true e ONVIO_EMAIL/ONVIO_PASSWORD estiverem preenchidos (capture antes do envio).
ONVIO_UDS_TOKEN=
ONVIO_BASE_URL=https://onvio.com.br
# ID da empresa/firma no Onvio usado nas APIs core. ONVIO_COMPANY_ID tambem e aceito.
ONVIO_FIRM_COMPANY_ID=DA26DD8B76C04A7B9A5EE3D029347E4D
# Opcional: cookie HTTP do Onvio, se o endpoint exigir contexto adicional.
ONVIO_COOKIE=
# Credenciais do portal (obrigatórias se ONVIO_AUTO_REFRESH_TOKEN=true)
ONVIO_EMAIL=
ONVIO_PASSWORD=
# true = com token vazio, roda capture-tokens antes do upload; em 401, roda de novo uma vez (Playwright; MFA via ONVIO_MFA_* em shared/onvio-auth)
ONVIO_AUTO_REFRESH_TOKEN=false
ONVIO_DEPARTMENT_NAME=SETOR FISCAL
ONVIO_DEPARTMENT_ID=
# ID do solicitante no Onvio (opcional mas recomendado). Se vazio, o portal pode mostrar Solicitante em branco,
# a menos que a planilha tenha coluna Solicitante com nome igual ao usuario do cliente no Onvio ou coluna ONVIO_REQUESTER_ID por linha.
ONVIO_REQUESTER_ID=
ONVIO_CLIENT_ID=
ONVIO_SKIP_ATTACHMENTS=false
ONVIO_DRY_RUN=false
# Opcional: sobrescreve a pasta normalizada usada no upload.
UNECONT_UPLOAD_DIR=
# Opcional: sobrescreve o caminho do checkpoint de upload. Vazio = runtime/checkpoints/upload-onvio-<lote>.json.
ONVIO_UPLOAD_CHECKPOINT_PATH=
# Opcional: vídeo (ex. .mp4) anexado a cada solicitação Onvio no upload com anexos (relatório NFS).
UNECONT_ONVIO_NFS_VIDEO_PATH=

# Legado: API local BD (companies/employees/departments). O upload Unecont nao depende mais dela —
# clientId vem da planilha, solicitante e departamentos via APIs Onvio.
BD_API_BASE_URL=http://localhost:3000/api
