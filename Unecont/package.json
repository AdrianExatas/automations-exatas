{
  "name": "unecont",
  "version": "1.0.0",
  "description": "Biblioteca standalone para download de relatorios Unecont e upload no Onvio",
  "private": true,
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js"
    }
  },
  "scripts": {
    "download": "tsx src/scripts/run.ts",
    "run": "tsx src/scripts/run.ts",
    "reformat-downloads": "tsx src/scripts/reformat-downloads.ts",
    "upload": "tsx src/scripts/upload-onvio.ts",
    "build": "tsc -p tsconfig.json",
    "test": "vitest run --config vitest.config.ts"
  },
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "dotenv": "^16.4.0",
    "exceljs": "^4.4.0",
    "playwright": "^1.51.1",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.0.0",
    "vitest": "^4.0.18"
  }
}
