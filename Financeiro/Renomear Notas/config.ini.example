# Exemplo de configuração para Renomear Notas
# Copie para config.ini e ajuste os valores.
# Valores na linha de comando têm prioridade sobre o config.ini.

[renomear_notas]
# Competência no formato MM-AAAA (ex.: 12-2025). Se vazio, usa o mês anterior à execução.
competencia =

# Prefixo para notas de serviço (competência é acrescentada automaticamente se usar --competencia).
# Exemplo resultante: "NOTA FISCAL SERVIÇO CONTÁBIL 1-2 COMP 09-2025 "
prefixo_servico = NOTA FISCAL SERVIÇO CONTÁBIL 1-2 COMP

# Prefixo para notas de produtos
prefixo_produtos = NOTA FISCAL SERVIÇO CONTÁBIL 2-2 COMP

# Pasta de destino dos arquivos renomeados (relativa à pasta-origem ou absoluta).
# Se vazio, usa "RENOMEADOS" na pasta de origem.
pasta_destino = RENOMEADOS
