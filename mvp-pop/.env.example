# ollama | gemini | mock (mock = smoke sem IA real)
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b
OLLAMA_TIMEOUT_MS=180000

# Só necessário se LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

REDIS_URL=redis://localhost:6379

STORAGE_PATH=./storage
DATABASE_PATH=./storage/mvp-pop.db
PUBLISH_ROOT=./storage/GESTAO DE PROCESSOS
GERADOR_ROOT=./vendor/gerador

BASE_URL=http://localhost:3100
PORT=3100
MAX_RETRIES=3
QUEUE_CONCURRENCY=1
BUILD_CONCURRENCY=1

# 1 = pula Word/Excel COM (útil para testes sem Office)
SKIP_OFFICE=0

# 1 = processa fila em processo (sem Redis/Docker)
INLINE_QUEUE=0

# Webhook opcional após aprovação (deixe vazio para desativar)
NOTIFY_WEBHOOK_URL=
