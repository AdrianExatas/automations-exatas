{
  "name": "@exatas/onvio-auth",
  "version": "1.0.0",
  "private": true,
  "description": "Biblioteca compartilhada para login Onvio e captura de tokens Onvio/Gestta",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    ".env.example"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepare": "bun run build",
    "capture-tokens": "tsx src/scripts/capture-tokens.ts",
    "test": "vitest run --config vitest.config.ts"
  },
  "type": "commonjs",
  "dependencies": {
    "dotenv": "^16.4.5",
    "playwright": "^1.51.1",
    "typescript": "^5.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.0.0",
    "vitest": "^4.0.18"
  }
}
