{
  "name": "dte-consulta-spe",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.11",
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "start": "bun run build && node --env-file=.env dist/index.js",
    "report:enhance": "bun run build && node dist/enhance-report.js",
    "build": "bun run clean && bunx tsc -p tsconfig.json",
    "typecheck": "bunx tsc -p tsconfig.test.json",
    "test": "bun test tests",
    "test:live": "bun run build && node --env-file=.env dist/live-smoke.js"
  },
  "dependencies": {
    "exceljs": "^4.4.0",
    "odbc": "^2.5.0",
    "playwright": "^1.58.2"
  },
  "devDependencies": {
    "@types/bun": "^1.3.11",
    "@types/node": "^22.19.15",
    "typescript": "^6.0.2"
  },
  "trustedDependencies": [
    "odbc"
  ]
}
