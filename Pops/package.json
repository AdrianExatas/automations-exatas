{
  "name": "auto-pop-hub",
  "version": "1.0.0",
  "description": "Hub de geração automática de POPs a partir de transcrições com agentes de IA",
  "type": "module",
  "scripts": {
    "dev": "bun run --watch src/index.ts",
    "start": "bun run src/index.ts",
    "worker": "bun run src/workers/start-worker.ts",
    "test": "bun test",
    "db:migrate": "bun run src/db/migrate.ts",
    "setup:d-drive": "powershell -ExecutionPolicy Bypass -File scripts/setup-d-drive.ps1"
  },
  "dependencies": {
    "@elysiajs/cors": "^1.2.0",
    "@elysiajs/static": "^1.2.0",
    "@google/generative-ai": "^0.24.0",
    "bullmq": "^5.40.0",
    "docx": "^9.3.0",
    "drizzle-orm": "^0.40.0",
    "elysia": "^1.2.0",
    "ioredis": "^5.6.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5.7.0"
  }
}
