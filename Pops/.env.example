LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b
OLLAMA_TIMEOUT_MS=120000

# Só necessário se LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

REDIS_URL=redis://localhost:6379

# Armazenamento no disco D: (uploads, outputs, banco SQLite)
STORAGE_PATH=D:/auto-pop-hub
DATABASE_PATH=D:/auto-pop-hub/auto-pop.db

# Modelos Ollama: definir OLLAMA_MODELS=D:/ollama-models no Windows
# Execute: bun run setup:d-drive  (ou scripts/setup-d-drive.ps1)

BASE_URL=http://localhost:3000
MAX_RETRIES=3
PORT=3000
QUEUE_CONCURRENCY=2
