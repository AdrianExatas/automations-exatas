{
  "name": "sefaz-ma",
  "version": "1.0.0",
  "description": "Projeto de automacao web em TypeScript com Playwright usando Chrome via Bun.",
  "main": "dist/index.js",
  "scripts": {
    "dev": "bunx playwright test src/index.spec.ts --headed",
    "build": "bunx tsc -p tsconfig.json",
    "start": "bun run dist/index.js",
    "test": "bunx playwright test src/index.spec.ts",
    "test:headed": "bunx playwright test src/index.spec.ts --headed",
    "codegen": "bunx playwright codegen --channel=chrome",
    "chrome:install": "bunx playwright install chrome"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@types/node": "^25.5.0",
    "playwright": "^1.58.2",
    "typescript": "^6.0.2"
  },
  "dependencies": {
    "cheerio": "^1.2.0",
    "exceljs": "^4.4.0"
  }
}
