{
  "name": "sefaz-pi",
  "version": "1.0.0",
  "description": "Projeto de automacao web em TypeScript com Playwright usando Chrome.",
  "packageManager": "bun@1.3.11",
  "main": "dist/index.js",
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "dev": "bunx playwright test --headed",
    "build": "bun run clean && bunx tsc -p tsconfig.json",
    "start": "node --env-file=.env dist/index.js",
    "test": "bunx playwright test",
    "test:headed": "bunx playwright test --headed",
    "test:integration": "RUN_SEFAZ_PI_INTEGRATION=1 bunx playwright test src/portal.integration.spec.ts --headed",
    "codegen": "bunx playwright codegen --channel=chrome",
    "chrome:install": "bunx playwright install chrome"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@types/node": "^25.5.0",
    "playwright": "^1.58.2",
    "typescript": "^6.0.2"
  },
  "dependencies": {
    "cheerio": "^1.2.0",
    "exceljs": "^4.4.0",
    "undici": "^8.0.2"
  }
}
