{
  "name": "dte-caixapostal",
  "version": "1.0.0",
  "description": "Projeto de automacao web em TypeScript com Playwright",
  "packageManager": "bun@1.3.11",
  "main": "dist/electron/main.js",
  "scripts": {
    "clean": "rimraf dist release",
    "build:ts": "tsc -p tsconfig.build.json",
    "build:assets": "node scripts/copy-static.mjs",
    "build": "bun run clean && bun run build:ts && bun run build:assets",
    "compare:domain-sefaz": "ts-node src/scripts/compareDomainSefaz.ts",
    "test": "playwright test",
    "test:unit": "playwright test tests/config.spec.ts tests/caixaPostalDomain.spec.ts tests/caixaPostalReport.spec.ts tests/domainSefazComparison.spec.ts tests/sefazHttpClient.spec.ts",
    "test:automation": "playwright test tests/verificarCaixaPostal.spec.ts tests/verificarCaixaPostalBrowser.spec.ts",
    "test:headed": "playwright test --headed",
    "electron:start": "bun run build && electron .",
    "pack": "bun run build && electron-builder --dir",
    "dist": "bun run build && electron-builder",
    "codegen": "playwright codegen --channel chrome",
    "show-report": "playwright show-report"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "cheerio": "^1.2.0",
    "exceljs": "^4.4.0",
    "playwright-core": "^1.58.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@types/node": "^25.5.0",
    "electron": "^37.2.0",
    "electron-builder": "^26.0.12",
    "rimraf": "^6.0.1",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.2"
  },
  "build": {
    "appId": "com.exatas.dtecaixapostal",
    "productName": "DTE Caixa Postal",
    "directories": {
      "output": "release",
      "buildResources": "build-resources"
    },
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "certificado",
        "to": "certificado",
        "filter": [
          "*.pfx",
          "Senha.txt"
        ]
      }
    ],
    "asar": true,
    "asarUnpack": [
      "node_modules/playwright-core/**/*"
    ],
    "win": {
      "signAndEditExecutable": false,
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
