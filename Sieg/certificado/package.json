{
  "name": "sieg-certificado",
  "version": "1.0.0",
  "description": "Cadastro/atualização de certificado digital na API SIEG",
  "type": "module",
  "main": "dist/client.js",
  "bin": {
    "atualizar-certificado": "dist/atualizar-certificado.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/atualizar-certificado.js",
    "certificado": "node dist/atualizar-certificado.js",
    "dev": "tsx src/atualizar-certificado.ts",
    "server": "node dist/server.js",
    "web": "npm run build && node dist/server.js"
  },
  "keywords": ["sieg", "certificado", "pfx", "api"],
  "author": "",
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "node-forge": "^1.3.1"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "tsx": "^4.7.0",
    "typescript": "^5.3.0"
  }
}
