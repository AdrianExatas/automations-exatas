{
  "name": "certificado-manager",
  "version": "1.0.0",
  "description": "Gerenciador unificado de certificados digitais - SIEG, UNECONT e ONVIO",
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc",
    "build:client": "npm run build --prefix client",
    "build:all": "npm run build && npm run build:client",
    "server": "node dist/server.js",
    "dev": "tsx src/server/server.ts",
    "dev:server": "tsx src/server/server.ts",
    "dev:client": "npm run dev --prefix client",
    "dev:both": "concurrently -n server,client -c blue,green \"npm run dev:server\" \"npm run dev:client\"",
    "web": "npm run build:all && npm run server",
    "test": "playwright test",
    "test:unecont": "playwright test src/automations/unecont/",
    "test:onvio": "playwright test src/automations/onvio/",
    "test:headed": "playwright test --headed",
    "codegen": "playwright codegen"
  },
  "keywords": [
    "sieg",
    "unecont",
    "onvio",
    "certificado",
    "pfx",
    "playwright",
    "automation"
  ],
  "author": "",
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "node-forge": "^1.3.1",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.0",
    "@types/node": "^22.10.0",
    "concurrently": "^9.1.0",
    "tsx": "^4.7.0",
    "typescript": "^5.7.0"
  }
}
