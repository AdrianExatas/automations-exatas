# ===========================================
# Configurações do Certificado Manager
# ===========================================

# --- API SIEG ---
SIEG_API_KEY=sua-api-key-sieg
SIEG_API_BASE_URL=https://api.sieg.com
SIEG_CERTIFICADO_BASE=api/Certificado
SIEG_REQUEST_TIMEOUT=30

# --- UNECONT ---
UNECONT_EMAIL=seu-email@exemplo.com
UNECONT_PASSWORD=sua-senha

# --- ONVIO ---
# Usados para pré-preencher o formulário na aba ONVIO e, no CLI, para "npm run test:onvio".
# Na execução pela interface web, os valores usados são sempre os enviados no formulário
# (e-mail, senha, CNPJ, arquivo .pfx e senha do certificado) — o .env não é usado na execução.
ONVIO_EMAIL=seu-email@exemplo.com
ONVIO_PASSWORD=sua-senha
# Apenas para teste via CLI (npm run test:onvio); a interface web não usa estas variáveis.
# ONVIO_PFX_PATH=./caminho/certificado.pfx
# ONVIO_PFX_PASSWORD=senha-do-certificado
# Pré-preenche o campo CNPJ na aba ONVIO ao carregar a página (opcional).
# ONVIO_CNPJ=00000000000000
ONVIO_BASE_URL=https://onvio.com.br

# --- Servidor ---
PORT=3000
DEBUG=false
