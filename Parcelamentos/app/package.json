{
  "name": "parcelamentos-sefaz-app",
  "version": "1.0.0",
  "description": "Aplicativo desktop unificado para download de parcelamentos SEFAZ AL, PI e SE",
  "author": "Exatas",
  "private": true,
  "main": "dist/electron/main.js",
  "scripts": {
    "build": "node scripts/build-electron.mjs",
    "electron:dev": "npm run build && electron .",
    "desktop:dist": "npm run build && electron-builder --win nsis",
    "typecheck": "tsc -p tsconfig.json"
  },
  "build": {
    "appId": "br.com.exatas.parcelamentos.sefaz",
    "productName": "Parcelamentos SEFAZ",
    "directories": {
      "output": "release"
    },
    "toolsets": {
      "winCodeSign": null
    },
    "files": [
      "dist/electron/**/*",
      "package.json",
      "node_modules/playwright/**/*",
      "node_modules/playwright-core/**/*",
      "node_modules/chromium-bidi/**/*",
      "!**/.tmp-playwright{,/**}",
      "!**/ms-playwright{,/**}"
    ],
    "asar": true,
    "win": {
      "signAndEditExecutable": false,
      "verifyUpdateCodeSignature": false,
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "packElevateHelper": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "dependencies": {
    "playwright": "^1.58.2",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/node": "^25.5.0",
    "electron": "^42.0.1",
    "electron-builder": "^26.8.1",
    "esbuild": "^0.28.0",
    "typescript": "^5.9.3"
  }
}
