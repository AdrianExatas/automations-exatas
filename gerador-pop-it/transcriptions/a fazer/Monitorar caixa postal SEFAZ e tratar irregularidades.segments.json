      "text": "Só que."
    },
    {
      "start": 579.4,
      "end": 580.4,
      "text": "Eu não vou mandar para mim."
    },
    {
      "start": 580.4,
      "end": 581.4,
      "text": "Vai mandar para mim."
    },
    {
      "start": 581.4,
      "end": 582.4,
      "text": "Para dar."
    },
    {
      "start": 582.4,
      "end": 583.4,
      "text": "Uma certa."
    },
    {
      "start": 583.4,
      "end": 584.4,
      "text": "Cuidado."
    },
    {
      "start": 584.4,
      "end": 585.4,
      "text": "Nessa ação."
    },
    {
      "start": 585.4,
      "end": 586.4,
      "text": "Nessa."
    },
    {
      "start": 586.4,
      "end": 587.4,
      "text": "Nessa multa."
    },
    {
      "start": 587.4,
      "end": 588.4,
      "text": "E essa multa."
    },
    {
      "start": 588.4,
      "end": 589.4,
      "text": "Para a gente tratar."
    },
    {
      "start": 589.4,
      "end": 590.4,
      "text": "Com o corpo jurídico."
    },
    {
      "start": 590.4,
      "end": 591.4,
      "text": "Então."
    },
    {
      "start": 591.4,
      "end": 592.4,
      "text": "Vou mandar aqui."
    },
    {
      "start": 592.4,
      "end": 593.4,
      "text": "No grupo de auditoria."
    },
    {
      "start": 593.4,
      "end": 594.4,
      "text": "Porque eu vou receber."
    },
    {
      "start": 594.4,
      "end": 595.4,
      "text": "Quem."
    },
    {
      "start": 595.4,
      "end": 596.4,
      "text": "Vai emitir."
    },
    {
      "start": 596.4,
      "end": 597.4,
      "text": "Para que a gente tenha."
    },
    {
      "start": 597.4,
      "end": 598.4,
      "text": "Um certo cuidado."
    },
    {
      "start": 598.4,
      "end": 599.4,
      "text": "Essa tarefa."
    },
    {
      "start": 599.4,
      "end": 600.4,
      "text": "De uma forma mais."
    },
    {
      "start": 600.4,
      "end": 601.4,
      "text": "Contudente."
    },
    {
      "start": 601.4,
      "end": 602.4,
      "text": "Beleza."
    },
    {
      "start": 602.4,
      "end": 603.4,
      "text": "Então."
    },
    {
      "start": 603.4,
      "end": 604.4,
      "text": "Aqui."
    },
    {
      "start": 604.4,
      "end": 605.4,
      "text": "É um mapeamento."
    },
    {
      "start": 605.4,
      "end": 606.4,
      "text": "De como deve seguir."
    },
    {
      "start": 606.4,
      "end": 607.4,
      "text": "O trâmite legal."
    },
    {
      "start": 607.4,
      "end": 608.4,
      "text": "Dessa tarefa."
    }
  ]
}