{
  "name": "sefaz-se-agil",
  "version": "1.0.0",
  "description": "Automacao AGIL SEFAZ-SE com interface Electron",
  "private": true,
  "type": "module",
  "main": "dist/electron/main.mjs",
  "scripts": {
    "agil": "tsx scripts/incluir-nota-fiscal.ts",
    "app:build": "bun run scripts/build-electron.ts",
    "app": "bun run scripts/start-electron.ts",
    "dist:win": "bun run app:build && electron-builder --win",
    "test": "bunx playwright test",
    "test:headed": "bunx playwright test --headed",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@playwright/test": "latest",
    "@types/archiver": "^7.0.0",
    "@types/bun": "^1.3.13",
    "@types/node": "^25.6.0",
    "electron": "^41.3.0",
    "electron-builder": "^26.8.1",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "archiver": "^7.0.1",
    "playwright": "^1.59.1",
    "xlsx": "^0.18.5"
  },
  "build": {
    "appId": "br.gov.se.sefaz.agil",
    "productName": "SEFAZ-SE AGIL",
    "directories": {
      "output": "release"
    },
    "files": [
      "**/*",
      "!src/**",
      "!scripts/**",
      "!tests/**",
      "!test-results/**",
      "!playwright-report/**",
      "!release/**",
      "!.cursor/**",
      "!.tmp/**",
      "!**/*.md",
      "!tsconfig.json",
      "!playwright.config.ts",
      "!bun.lock",
      "!**/.env",
      "!**/.env.*",
      "!**/node_modules/playwright/.local-browsers/**",
      "!**/node_modules/.cache/**"
    ],
    "asar": true,
    "win": {
      "target": ["nsis", "portable"],
      "signAndEditExecutable": false
    }
  }
}
