{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": ["bun", "node"],
    "noEmit": true,
    "outDir": "dist"
  },
  "include": [
    "src/**/*.ts",
    "test/**/*.ts",
    "../ALTERAR NOTA FISCAL - DIA ATUAL/src/**/*.ts",
    "../shared/**/*.ts"
  ],
  "exclude": [
    "../ALTERAR NOTA FISCAL - DIA ATUAL/src/electron/**",
    "../ALTERAR NOTA FISCAL - DIA ATUAL/src/main.ts",
    "../ALTERAR NOTA FISCAL - DIA ATUAL/test/**"
  ]
}
