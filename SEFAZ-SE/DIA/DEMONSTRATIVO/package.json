{
  "name": "sefaz-se-dia-new",
  "version": "1.0.0",
  "description": "Aplicacao desktop unificada SEFAZ-SE DIA (Demonstrativo e Alterar Nota Fiscal).",
  "author": "Exatas",
  "private": true,
  "type": "module",
  "main": "dist/electron/main.js",
  "scripts": {
    "build": "bun run generate:sieg-key && bun run build:main && bun run build:preload && bun run build:renderer && bun run build:assets",
    "generate:sieg-key": "bun run scripts/generate-sieg-key.ts",
    "build:main": "bun build src/electron/main.ts --target=node --outdir=dist/electron --external=electron --external=playwright --external=playwright-core --sourcemap=external",
    "build:preload": "bun build src/electron/preload.ts --target=node --format=cjs --outfile=dist/electron/preload.cjs --external=electron",
    "build:renderer": "bun build src/electron/renderer.ts --target=browser --outdir=dist/electron --sourcemap=external",
    "build:assets": "bun run scripts/copy-electron-assets.ts",
    "desktop:dev": "bun run build && electron .",
    "desktop:dist": "bun run build && electron-builder --win nsis",
    "probe:har": "bun --env-file=.env run scripts/probe-demonstrativo-har.ts",
    "test:http": "bun build scripts/test-http-download.ts --outfile=dist/scripts/test-http-download.mjs --target=node --external=playwright --external=playwright-core && node --env-file=.env dist/scripts/test-http-download.mjs",
    "start": "bun run src/main.ts",
    "test": "bun run generate:sieg-key && bun test",
    "typecheck": "bun run generate:sieg-key && bunx tsc -p tsconfig.json"
  },
  "dependencies": {
    "node-forge": "^1.4.0",
    "playwright": "^1.58.2",
    "tough-cookie": "^6.0.2",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/bun": "^1.3.4",
    "@types/node": "^22.15.3",
    "@types/node-forge": "^1.3.14",
    "electron": "^38.5.0",
    "electron-builder": "^26.0.12",
    "typescript": "^5.9.3"
  },
  "build": {
    "appId": "br.com.exatas.sefaz.se.dia",
    "productName": "SEFAZ-SE DIA",
    "directories": {
      "output": "release"
    },
    "toolsets": {
      "winCodeSign": null
    },
    "files": [
      "dist/electron/**/*",
      "package.json",
      "node_modules/playwright/**/*",
      "node_modules/playwright-core/**/*",
      "node_modules/chromium-bidi/**/*",
      "!**/.tmp-playwright{,/**}",
      "!**/ms-playwright{,/**}"
    ],
    "asar": true,
    "win": {
      "signAndEditExecutable": false,
      "verifyUpdateCodeSignature": false,
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "packElevateHelper": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
