{
  "name": "s5002-organizador",
  "version": "1.0.0",
  "description": "Aplicacao desktop para organizar XMLs eSocial S-5002 e S-2501 por CPF e periodo de apuracao.",
  "author": "Exatas",
  "private": true,
  "type": "module",
  "main": "dist/electron/main.js",
  "scripts": {
    "build": "bun run build:main && bun run build:preload && bun run build:renderer && bun run build:assets",
    "build:main": "bun build src/electron/main.ts --target=node --outdir=dist/electron --external=electron --sourcemap=external",
    "build:preload": "bun build src/electron/preload.ts --target=node --format=cjs --outfile=dist/electron/preload.cjs --external=electron",
    "build:renderer": "bun build src/electron/renderer.ts --target=browser --outdir=dist/electron --sourcemap=external",
    "build:assets": "bun run scripts/copy-electron-assets.ts",
    "desktop:dev": "bun run build && electron .",
    "desktop:dist": "bun run build && electron-builder --win nsis",
    "test": "bun test",
    "typecheck": "bunx tsc -p tsconfig.json"
  },
  "dependencies": {
    "fast-xml-parser": "^5.3.2",
    "fflate": "^0.8.2",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/bun": "^1.3.4",
    "@types/node": "^22.15.3",
    "electron": "^38.5.0",
    "electron-builder": "^26.0.12",
    "typescript": "^5.9.3"
  },
  "build": {
    "appId": "br.com.exatas.dp.s5002.organizador",
    "productName": "Organizador S-5002 e S-2501",
    "directories": {
      "output": "release"
    },
    "toolsets": {
      "winCodeSign": null
    },
    "files": [
      "dist/electron/**/*",
      "package.json"
    ],
    "asar": true,
    "win": {
      "signAndEditExecutable": false,
      "verifyUpdateCodeSignature": false,
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "packElevateHelper": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
